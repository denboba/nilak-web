// Nilak Web on Cloudflare Workers: serves the built site in `dist` as static files
// Cloudflare build settings: build command `bash deploy/cloudflare-build.sh`, deploy command `npx wrangler deploy`
{
  "name": "nilak",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
